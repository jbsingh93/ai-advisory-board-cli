{
  "name": "aabclitool",
  "version": "0.1.0",
  "description": "AI Advisory Board CLI — convene a panel of Claude sub-agents on any business question, and turn the resulting action items into installed Claude Code skills.",
  "type": "module",
  "bin": {
    "aab": "dist/bin/aab.js"
  },
  "files": [
    "dist",
    "gui",
    "README.md",
    "PLAN"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/aab.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "enquirer": "^2.4.1",
    "express": "^4.21.0",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "proper-lockfile": "^4.1.2",
    "slugify": "^1.6.6",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.5.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "keywords": [
    "claude",
    "claude-code",
    "advisory-board",
    "agents",
    "skills",
    "cli"
  ],
  "license": "MIT"
}
