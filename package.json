{
  "name": "ai-advisory-board",
  "version": "0.7.0",
  "description": "AI Advisory Board CLI — convene a panel of Claude sub-agents on any business question, and turn the resulting action items into installed Claude Code skills.",
  "type": "module",
  "bin": {
    "aab": "dist/bin/aab.js"
  },
  "files": [
    "dist",
    "gui",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/aab.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build && changeset publish"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "ora": "^9.4.0",
    "proper-lockfile": "^4.1.2",
    "slugify": "^1.6.6",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/mcp": "0.0.75",
    "@playwright/test": "^1.49.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-sub-agents",
    "advisory-board",
    "multi-agent",
    "agents",
    "skills",
    "cli",
    "decision-making",
    "kanban"
  ],
  "license": "Apache-2.0",
  "author": "Julian Bent Singh <dinegenboss@gmail.com> (https://github.com/jbsingh93)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbsingh93/ai-advisory-board-cli.git"
  },
  "homepage": "https://github.com/jbsingh93/ai-advisory-board-cli#readme",
  "bugs": {
    "url": "https://github.com/jbsingh93/ai-advisory-board-cli/issues"
  },
  "funding": "https://github.com/sponsors/jbsingh93",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
